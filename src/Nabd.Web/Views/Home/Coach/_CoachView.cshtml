    <!-- =======================================================
         VIEW 4: INTERACTIVE AI CLINICAL COACH (#view-coach)
         Organized, high-contrast layout:
         - Primary Coach Workspace on the Right/Center (expands to full width when sidebar is closed)
         - Collapsible Weakness Mastery Sidebar on the LEFT (toggled via button just like the simulation sidebar)
         ======================================================= -->
    <section id="view-coach" class="hidden max-w-[1440px] mx-auto px-2 sm:px-4 py-1.5 sm:py-2">
      <div class="flex gap-3 items-stretch relative min-h-[540px] h-[calc(100dvh-4.75rem)]">

        <!-- PRIMARY AREA (Right/Center, Flex-1): Interactive Conversational Coach Workspace (Maximized Chat Area) -->
        <div id="coach-main-column" class="flex-1 bg-white border border-slate-200 rounded-2xl shadow-xs flex flex-col min-w-0 min-h-0 overflow-hidden">
          <!-- Ultra-Compact Single-Line Coach Header Bar -->
          <div class="px-3.5 py-2 border-b border-slate-200/80 bg-white flex items-center justify-between gap-2 shrink-0 flex-wrap">
            <div class="flex items-center gap-2 min-w-0">
              <div class="w-8 h-8 rounded-xl bg-teal-700 text-white flex items-center justify-center font-bold text-xs shadow-2xs shrink-0">
                م
              </div>
              <h1 class="text-sm sm:text-base font-bold text-slate-900 truncate">المدرب السريري</h1>
              <span id="coach-active-module-badge" class="px-2.5 py-0.5 rounded-full bg-teal-50 text-teal-900 border border-teal-300 text-xs font-bold">القلب والطوارئ</span>
            </div>

            <!-- Left Actions in Coach Header: Back Home + Toggle Left Weakness Sidebar Button -->
            <div class="flex items-center gap-1.5 shrink-0">
              <button type="button" id="coach-back-home-btn" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold transition-colors focus-ring">
                الرئيسية
              </button>
              <button type="button" id="toggle-coach-weakness-btn" aria-expanded="false" class="px-3 py-1.5 rounded-xl bg-teal-50 hover:bg-teal-100 text-teal-900 border border-teal-300 text-xs font-bold transition-colors flex items-center gap-1.5 focus-ring" title="إظهار أو إخفاء شريط نقاط الضعف الجانبي">
                <svg class="w-3.5 h-3.5 text-teal-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/></svg>
                <span id="toggle-coach-weakness-label">المحاور (4)</span>
              </button>
            </div>
          </div>

          <!-- Scrollable Coach Chat Messages (Expanded Height, Right-Aligned RTL, High-Contrast Typography) -->
          <div id="coach-chat-messages" class="flex-1 overflow-y-auto px-3.5 sm:px-5 py-3.5 space-y-3.5 bg-[#F8F6F2] min-h-0" aria-live="polite">
            <!-- Populated by JS -->
          </div>

          <!-- Compact Single-Row Quick Assist & Hint Strip -->
          <div class="px-3.5 py-1.5 border-t border-slate-200/80 bg-slate-50 flex items-center justify-between gap-2 flex-wrap shrink-0">
            <div class="flex items-center gap-1.5 overflow-x-auto" id="coach-quick-chips">
              <!-- Populated by JS -->
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
              <button type="button" id="coach-give-hint-btn" class="px-2.5 py-1 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-300 text-xs font-bold transition-colors">تلميح</button>
              <button type="button" id="coach-header-next-btn" class="px-2.5 py-1 rounded-lg bg-teal-50 hover:bg-teal-100 text-teal-900 border border-teal-200 text-xs font-bold transition-colors">التالي ←</button>
            </div>
          </div>

          <!-- Coach Chat Input Bar -->
          <div class="p-2.5 sm:p-3 border-t border-slate-200 bg-white flex items-center gap-2 shrink-0">
            <input id="coach-chat-input" type="text" placeholder="اكتب إجابتك…" class="flex-1 text-xs sm:text-sm font-medium text-slate-900 bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 focus:outline-none focus:bg-white focus:border-teal-600" />
            <button id="coach-send-btn" type="button" class="px-5 py-2 rounded-xl bg-teal-700 hover:bg-teal-800 text-white text-xs sm:text-sm font-bold transition-colors shrink-0 shadow-2xs focus-ring">
              إرسال
            </button>
          </div>
        </div>

        <!-- COLLAPSIBLE LEFT SIDEBAR: Weakness Mastery Queue & Progress (#coach-weakness-panel) with Neat Border Radius -->
        <div id="coach-weakness-backdrop" class="fixed inset-0 z-45 bg-slate-900/40 backdrop-blur-xs hidden lg:hidden" style="z-index: 45;"></div>
        <aside id="coach-weakness-panel" aria-label="شريط نقاط الضعف ومحاور التقوية" class="sidebar-floating-drawer rounded-r-3xl hidden lg:hidden fixed inset-y-0 left-0 z-48 w-[340px] sm:w-[375px] max-w-[92vw] lg:static lg:z-auto lg:w-[360px] xl:w-[385px] bg-white border border-slate-200 rounded-3xl shadow-2xl lg:shadow-xs flex-col justify-between p-4 min-h-0 overflow-hidden transition-all duration-200" style="z-index: 48;">
          <div class="space-y-4 overflow-y-auto flex-1 min-h-0 pr-0.5">
            <!-- Panel Header with Close / Collapse Button -->
            <div class="flex items-center justify-between border-b border-slate-200/80 pb-3">
              <div>
                <span class="text-xs font-bold text-teal-700 block">الشريط الجانبي · خطة التقوية</span>
                <h2 class="text-base font-bold text-slate-900 mt-0.5">نقاط الضعف ومحاور التدريب</h2>
              </div>
              <button type="button" id="close-coach-weakness-btn" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center text-xs font-bold transition-colors focus-ring" aria-label="إغلاق شريط نقاط الضعف" title="إخفاء شريط نقاط الضعف">
                ✕
              </button>
            </div>

            <!-- Mastery Progress Box -->
            <div class="p-4 rounded-2xl bg-teal-50/80 border border-teal-200 space-y-2.5">
              <div class="flex items-center justify-between text-xs sm:text-sm">
                <span class="font-bold text-teal-900">نسبة إتقان نقاط الضعف:</span>
                <span id="coach-mastery-percent" class="font-bold text-teal-900 bg-white px-2.5 py-0.5 rounded-lg border border-teal-200 font-num">0% (0/4 مكتمل)</span>
              </div>
              <div class="w-full h-2.5 rounded-full bg-teal-100 overflow-hidden">
                <div id="coach-mastery-bar" class="h-full bg-teal-700 transition-all duration-300" style="width: 0%;"></div>
              </div>
              <p id="coach-remaining-count" class="text-xs sm:text-sm text-teal-900 font-semibold leading-snug">
                باقي عليك 4 نقاط ضعف للتدرب عليها واجتيازها مع المدرب.
              </p>
            </div>

            <!-- Interactive Weakness Checklist Queue -->
            <div class="space-y-2.5">
              <div class="text-xs sm:text-sm font-bold text-slate-800">اضغط على أي محور لبدء تمرين المحاكاة الخاص به:</div>
              <div id="coach-weakness-queue" class="space-y-2.5">
                <!-- Populated by JS -->
              </div>
            </div>
          </div>

          <div class="pt-3.5 mt-3 border-t border-slate-200/80 flex items-center justify-between gap-2 shrink-0">
            <button type="button" id="coach-next-drill-btn" class="flex-1 py-2.5 rounded-xl bg-teal-700 hover:bg-teal-800 text-white text-xs sm:text-sm font-bold transition-colors focus-ring">
              التمرين التالي ←
            </button>
            <button type="button" id="coach-reset-drills-btn" class="px-3.5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs sm:text-sm font-bold transition-colors focus-ring">
              إعادة الضبط
            </button>
          </div>
        </aside>

      </div>
    </section>
