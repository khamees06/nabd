    <section id="view-sim" class="hidden w-full max-w-[1440px] mx-auto px-0 sm:px-3 py-0 h-[calc(100dvh-4rem)] flex flex-col overflow-hidden">

      <!-- Main Simulation Workspace Body (Starts Directly Below Header to Bottom of Screen - Zero Bars Above Chat) -->
      <div class="flex-1 flex gap-2.5 min-h-0 relative overflow-hidden">

        <!-- PRIMARY AREA: Clinical Chat Directly From Under Header to Bottom of Screen -->
        <div id="sim-chat-column" class="flex-1 bg-white border-x sm:border border-slate-200/90 sm:rounded-b-2xl shadow-2xs flex flex-col min-w-0 min-h-0 overflow-hidden">

          <div id="sim-osce-bar" role="timer"><span>وضع الامتحان (OSCE)</span><span>الوقت المتبقي <b id="sim-osce-time" class="font-num">--:--</b></span><span>التلميحات معطّلة</span></div>
          <div id="sim-level-hint" role="note"></div>
          <!-- Scrollable Chat Messages Stream (Starts at 0px below header! First row holds transient session info) -->
          <div id="sim-chat-messages" class="flex-1 overflow-y-auto px-3 sm:px-5 py-3 space-y-3 bg-[#FAF9F6] min-h-0" aria-live="polite">
            <!-- Populated by JS: First row is #sim-inline-patient-card which disappears when messages continue -->
          </div>

          <!-- Compact Suggested Questions Strip (Integrated at bottom above input, auto-collapsible) -->
          <div id="sim-suggestions-bar" class="px-3 py-1.5 border-t border-slate-100 bg-white shrink-0">
            <div id="sim-suggested-questions" class="flex items-center gap-1.5 overflow-x-auto pb-0.5">
              <!-- Populated by JS -->
            </div>
          </div>

          <!-- Fixed Bottom Chat Input & Action Bar (Contains Input + Send + Vitals/Tools/SBAR Actions) -->
          <div class="p-2.5 border-t border-slate-200/80 bg-white flex items-center gap-1.5 sm:gap-2 shrink-0 flex-wrap sm:flex-nowrap">
            <button id="sim-voice-btn" type="button" class="p-2 rounded-xl border border-slate-200 text-slate-600 hover:text-teal-700 hover:bg-slate-50 transition-colors shrink-0 focus-ring" title="التحدث بالصوت" aria-label="إدخال صوتي">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
            </button>
            <input id="sim-chat-input" type="text" placeholder="اكتب سؤالك للمريض..." class="flex-1 min-w-[160px] text-xs sm:text-sm bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 focus:outline-none focus:bg-white focus:border-teal-600 transition-colors" />
            <button id="sim-send-btn" type="button" class="px-4 py-2 rounded-xl bg-teal-700 hover:bg-teal-800 text-white text-xs sm:text-sm font-bold transition-colors shrink-0 focus-ring">
              إرسال
            </button>
            <button id=" toggle-sim-tools-btn-quick" type="button" onclick="document.getElementById('sim-measure-vitals-btn').click()" class="px-2.5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-emerald-300 text-xs font-bold transition-colors shrink-0 focus-ring" title="قياس العلامات الحيوية وإرسالها للشات">
              العلامات
            </button>
            <button id="toggle-sim-tools-btn" aria-expanded="true" type="button" class="px-2.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-200/80 text-xs font-semibold transition-colors flex items-center gap-1 shrink-0 focus-ring" title="إظهار/إخفاء لوحة العلامات والمفكرة والفحوصات">
              <svg class="w-3.5 h-3.5 text-teal-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/></svg>
              <span id="toggle-sim-tools-label" class="hidden sm:inline">الفحوصات</span>
            </button>
            <button id="open-handover-modal-btn" type="button" class="px-3 py-2 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold transition-colors shadow-2xs shrink-0 focus-ring">
              تسليم SBAR
            </button>
          </div>
        </div>

        <div id="sim-tools-backdrop" class="fixed inset-0 z-45 bg-slate-900/40 backdrop-blur-xs hidden lg:hidden" style="z-index: 45;"></div>
        <aside id="sim-tools-panel" aria-label="أدوات الجلسة السريرية" class="hidden lg:flex fixed inset-y-0 left-0 z-48 w-[350px] sm:w-[390px] max-w-[92vw] lg:static lg:z-auto lg:w-[390px] xl:w-[410px] bg-white border border-slate-200/90 lg:rounded-2xl shadow-2xl lg:shadow-2xs flex-col min-h-0 overflow-hidden transition-all duration-200" style="z-index: 48;">

          <!-- Mobile Drawer Header + Tabs -->
          <div class="p-2 border-b border-slate-100 bg-slate-50/80 flex items-center justify-between gap-2 shrink-0">
            <div class="grid grid-cols-2 gap-1.5 flex-1">
              <button id="side-tab-vitals" data-stab="vitals" class="sim-side-tab py-1.5 px-2.5 rounded-xl text-xs font-bold transition-all bg-white text-teal-800 shadow-2xs border border-slate-200/70 focus-ring">
                العلامات
              </button>
              <button id="side-tab-workup" data-stab="workup" class="sim-side-tab py-1.5 px-2.5 rounded-xl text-xs font-bold transition-all text-slate-600 hover:text-slate-900 focus-ring">
                الفحوصات (<span id="workup-count-badge">0</span>)
              </button>
            </div>
            <button id="close-sim-tools-mobile" class="lg:hidden w-7 h-7 rounded-lg bg-slate-200/80 text-slate-700 flex items-center justify-center text-xs font-bold" aria-label="إغلاق لوحة الأدوات">
              ✕
            </button>
          </div>

          <div class="flex-1 overflow-y-auto p-3.5 space-y-3.5 min-h-0">

            <!-- TAB 1: VITALS MONITOR + NURSE SCRATCHPAD -->
            <div id="side-pane-vitals" class="space-y-3.5">
              <div class="bg-slate-900 text-white rounded-2xl p-3.5 border border-slate-800 space-y-2.5">
                <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="text-xs font-semibold text-slate-200">شاشة العلامات الحيوية</span>
                  </div>
                  <button id="sim-measure-vitals-btn" class="px-2.5 py-1 rounded-lg bg-teal-600 hover:bg-teal-500 text-white text-xs font-semibold transition-colors focus-ring">
                    قياس العلامات الآن
                  </button>
                </div>

                <div class="bg-slate-950/80 rounded-xl p-1.5 border border-slate-800/80">
                  <svg class="w-full h-7" viewBox="0 0 400 40" preserveAspectRatio="none" role="img" aria-label="مخطط نبض القلب">
                    <path class="ecg-animated" d="M 0 22 L 40 22 Q 46 16 52 22 L 65 22 L 70 28 L 76 5 L 82 35 L 88 22 L 105 16 L 115 22 L 170 22 Q 176 16 182 22 L 195 22 L 200 28 L 206 5 L 212 35 L 218 22 L 235 16 L 245 22 L 300 22 Q 306 16 312 22 L 325 22 L 330 28 L 336 5 L 342 35 L 348 22 L 365 16 L 375 22 L 400 22" fill="none" stroke="#0F7D44" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                </div>

                <div class="grid grid-cols-2 gap-2 font-num">
                  <div class="bg-slate-950/60 border border-slate-800 rounded-xl p-2">
                    <div class="text-xs text-slate-400 flex justify-between"><span>النبض HR</span><span>bpm</span></div>
                    <div id="sim-v-hr" class="text-lg font-bold text-emerald-400 mt-0.5">--</div>
                  </div>
                  <div class="bg-slate-950/60 border border-slate-800 rounded-xl p-2">
                    <div class="text-xs text-slate-400 flex justify-between"><span>الضغط BP</span><span>mmHg</span></div>
                    <div id="sim-v-bp" class="text-lg font-bold text-sky-400 mt-0.5">--/--</div>
                  </div>
                  <div class="bg-slate-950/60 border border-slate-800 rounded-xl p-2">
                    <div class="text-xs text-slate-400 flex justify-between"><span>الأكسجين SpO2</span><span>%</span></div>
                    <div id="sim-v-spo2" class="text-lg font-bold text-teal-300 mt-0.5">--%</div>
                  </div>
                  <div class="bg-slate-950/60 border border-slate-800 rounded-xl p-2">
                    <div class="text-xs text-slate-400 flex justify-between"><span>الحرارة Temp</span><span dir="ltr">°C</span></div>
                    <div id="sim-v-temp" class="text-lg font-bold text-amber-300 mt-0.5">--.-</div>
                  </div>
                </div>
                <div id="sim-vitals-note" class="text-xs text-slate-300">
                  اضغط «قياس العلامات الآن» لعرض القراءات.
                </div>
              </div>

              <!-- Nurse's Personal Scratchpad -->
              <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                  <label for="nurse-scratchpad" class="text-xs font-bold text-slate-800">ملاحظاتك</label>
                  <span class="text-xs text-slate-500">تنتقل إلى التسليم</span>
                </div>
                <textarea id="nurse-scratchpad" rows="4" placeholder="الحساسية، الأدوية، القراءات..." class="w-full p-3 rounded-2xl bg-[#F8F6F2] border border-slate-200 text-xs text-slate-800 leading-relaxed focus:outline-none focus:bg-white focus:border-teal-600 resize-none"></textarea>
              </div>
            </div>

            <!-- SECTION 2: DIAGNOSTIC WORKUP MENU -->
            <div id="side-pane-workup" class="space-y-2.5 pt-2.5 border-t border-slate-200/80">
              <div class="flex items-center justify-between">
                <strong class="text-xs font-bold text-teal-900">الفحوصات والصور:</strong>
                <span id="workup-log-status" class="text-xs font-semibold text-teal-700"></span>
              </div>

              <div class="flex items-center gap-1 flex-wrap" id="workup-category-tabs">
                <button data-wcat="all" class="wcat-btn px-2 py-1 rounded-lg text-xs font-semibold bg-teal-700 text-white">الكل</button>
                <button data-wcat="bedside" class="wcat-btn px-2 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200">سريري</button>
                <button data-wcat="lab" class="wcat-btn px-2 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200">مختبر وبول</button>
                <button data-wcat="imaging" class="wcat-btn px-2 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200">أشعة وتخطيط</button>
              </div>

              <div id="dynamic-workup-buttons" class="space-y-1.5 pr-0.5">
                <!-- Populated by JS -->
              </div>

              <div id="dynamic-workup-viewer" class="hidden"></div>
            </div>

          </div>
        </aside>

      </div>
    </section>
