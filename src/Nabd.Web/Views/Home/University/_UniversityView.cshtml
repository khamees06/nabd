        <!-- phase8 2026-11-07: portal tabs. The professor account also acts as the academic advisor. -->
        <div class="nb8-portal-note">
          <span class="nb8-demo-tag">بيانات تجريبية للعرض</span>
          <span>يستطيع المشرف الأكاديمي أن يعمل مرشداً أكاديمياً أيضاً. تُحفظ الواجبات والملاحظات على هذا الجهاز فقط.</span>
        </div>
        <div class="nb8-tabs" role="tablist" aria-label="أقسام البوابة الأكاديمية">
          <button type="button" role="tab" id="nb8-tab-courses" data-nb8-tab="courses" aria-controls="nb8-pane-courses" aria-selected="true" class="focus-ring">المساقات والشعب</button>
          <button type="button" role="tab" id="nb8-tab-assign" data-nb8-tab="assign" aria-controls="nb8-pane-assign" aria-selected="false" tabindex="-1" class="focus-ring">إسناد الحالات</button>
          <button type="button" role="tab" id="nb8-tab-reports" data-nb8-tab="reports" aria-controls="nb8-pane-reports" aria-selected="false" tabindex="-1" class="focus-ring">تقارير الطلبة</button>
