            <div>
              <label class="font-semibold text-slate-700 block mb-1" for="doc-case-title">عنوان الحالة السريرية والأمراض المرافقة:</label>
              <input id="doc-case-title" type="text" value="حالة باطنية مترافقة مع ارتفاع ضغط الدم والسكري" class="w-full p-2.5 rounded-xl bg-slate-50 border border-slate-200 focus:outline-none focus:bg-white focus:border-teal-600" />
            </div>
            <div>
              <label class="font-semibold text-slate-700 block mb-1" for="doc-case-dept">القسم السريري:</label>
              <select id="doc-case-dept" class="w-full p-2.5 rounded-xl bg-slate-50 border border-slate-200 focus:outline-none focus:bg-white focus:border-teal-600">
                <option value="cardio">القلب والأوعية الدموية</option>
                <option value="resp">الأمراض الصدرية والتنفسية</option>
                <option value="ortho">العظام والكسور</option>
                <option value="gi">الباطنية والجهاز الهضمي</option>
