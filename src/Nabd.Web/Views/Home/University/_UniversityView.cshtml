          </div>
          <div class="bg-white border border-slate-200/90 rounded-2xl p-5 shadow-xs space-y-1">
            <span class="text-xs font-semibold text-slate-500">النتائج المنشورة وسؤال الحساسية</span>
            <div class="text-2xl font-bold text-emerald-700 font-num" id="uni-prof-kpi-sub">--</div>
            <span class="text-xs text-slate-600 block" id="uni-prof-kpi-sub-sub"></span>
          </div>
          <div class="bg-white border border-slate-200/90 rounded-2xl p-5 shadow-xs space-y-1">
            <span class="text-xs font-semibold text-slate-500">متوسط درجات الشعبة</span>
            <div class="text-2xl font-bold text-teal-700 font-num" id="uni-prof-kpi-avg">--</div>
            <span class="text-xs text-slate-600 block" id="uni-prof-kpi-avg-sub"></span>
          </div>
          <div class="bg-amber-50/70 border border-amber-200 rounded-2xl p-5 shadow-xs space-y-1">
            <span class="text-xs font-bold text-amber-900">تنبيهات الفحوصات غير المبررة</span>
            <div class="text-base font-bold text-amber-800" id="uni-prof-kpi-warn">--</div>
            <span class="text-xs text-amber-700 block" id="uni-prof-kpi-warn-sub"></span>
          </div>
        </div>

        <!-- Organized Cohort Table Card -->
        <div class="bg-white border border-slate-200/90 rounded-3xl shadow-xs overflow-hidden">
          <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between flex-wrap gap-3">
            <div>
              <h2 class="text-base font-bold text-slate-900">تقارير طلبة الشعبة (NUR-402 / MED-410)</h2>
              <p class="text-xs text-slate-500">اضغط «عرض الإجابات» لفتح ملف الطالب.</p>
            </div>
            <div class="flex items-center gap-2 flex-wrap">
              <select id="prof-cohort-filter" class="px-3 py-2 rounded-xl bg-slate-50 border border-slate-200 text-xs font-semibold text-slate-700">
                <option value="all">جميع التخصصات والسنوات (7)</option>
                <option value="التمريض">طلاب التمريض</option>
                <option value="الطب">طلاب الطب البشري</option>
                <option value="weakness">طلاب لديهم فحوصات غير مبررة / ثغرات</option>
              </select>
              <button id="doc-export-csv-btn" class="px-4 py-2 rounded-xl bg-teal-50 hover:bg-teal-100 text-teal-800 border border-teal-200 text-xs font-bold transition-colors focus-ring">
                تصدير السجل الكامل (CSV)
              </button>
            </div>
          </div>
          <div class="overflow-x-auto">
            <table class="prof-structured-table">
              <thead>
                <tr>
                  <th>الطالب</th>
                  <th>التخصص والسنة</th>
                  <th>الحالة السريرية المختبرة</th>
                  <th>التشخيص المستنتج من الطالب</th>
                  <th>الفحوصات وتبرير الإضافي</th>
                  <th class="text-center">الدرجة والنشر</th>
                  <th class="text-center">إجراء المعلم</th>
                </tr>
              </thead>
              <tbody id="uni-prof-cohort-tbody">
                <!-- Populated dynamically by renderProfessorCohortTables() -->
              </tbody>
            </table>
          </div>
        </div>
        </div>

        <!-- phase8 pane 4: student progress (aggregated from the cohort data only) -->
        <div id="nb8-pane-progress" class="nb8-pane" role="tabpanel" aria-labelledby="nb8-tab-progress" hidden>
          <div class="nb8-card">
            <div class="nb8-card-head"><div><h2>تقدّم الطلبة</h2><p>ملخص المهارات محسوب من سجلات المحاولات المحفوظة فقط: الأسئلة التي طُرحت، وسؤال الحساسية، والفحوصات المبرّرة.</p></div></div>
            <div id="nb8-progress"></div>
          </div>
        </div>

        <!-- phase8 pane 5: academic advisor (the professor account acts as advisor) -->
        <div id="nb8-pane-advisor" class="nb8-pane" role="tabpanel" aria-labelledby="nb8-tab-advisor" hidden>
          <div class="nb8-card">
            <div class="nb8-card-head"><div><h2>المرشد الأكاديمي</h2><p>يستطيع المشرف الأكاديمي أن يعمل مرشداً أكاديمياً: تابع كل طالب، وحدّد حالة المتابعة، واكتب ملاحظة إرشادية تظهر للطالب في ملفه باسم «ملاحظة المرشد الأكاديمي».</p></div></div>
            <div id="nb8-advisor-sum" class="nb8-adv-sum"></div>
            <div id="nb8-advisor" class="nb8-adv-list"></div>
          </div>
        </div>
