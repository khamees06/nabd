        <!-- Supervisor Case Builder -->
        <div class="bg-white border border-slate-200/90 rounded-3xl p-6 shadow-xs space-y-4">
          <h2 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-3">إضافة حالة سريرية تدريبية جديدة (خاص بالأستاذ الجامعي)</h2>
