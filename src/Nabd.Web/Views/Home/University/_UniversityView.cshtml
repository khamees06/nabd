          </div>

          <button id="doc-save-case-btn" class="px-6 py-3 rounded-xl bg-teal-700 hover:bg-teal-800 text-white text-sm font-bold transition-colors shadow-xs focus-ring">
            حفظ الحالة وإضافتها لبطاقات الصفحة الرئيسية
          </button>
        </div>
          </details>
        </div>

        <!-- phase8 pane 3: student reports (KPI strip computed from the cohort data + the existing cohort table) -->
