  <!-- =========================================================
       TOAST NOTIFICATION BANNER
       ========================================================= -->
  <div id="calm-toast" role="status" aria-live="polite" class="fixed bottom-5 left-5 z-100 hidden max-w-md bg-slate-900 text-white px-4 py-3 rounded-2xl shadow-lg border border-slate-700 text-xs sm:text-sm leading-relaxed flex items-center justify-between gap-3" style="z-index: 100;">
    <span id="calm-toast-text"></span>
    <button id="calm-toast-close" class="text-slate-400 hover:text-white font-bold px-1.5" aria-label="إغلاق الإشعار">✕</button>
  </div>
