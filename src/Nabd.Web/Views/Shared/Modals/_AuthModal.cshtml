  <div id="auth-modal" role="dialog" aria-modal="true" aria-labelledby="auth-modal-title" class="fixed inset-0 z-85 bg-slate-900/50 backdrop-blur-xs hidden items-center justify-center p-3" style="z-index: 85;">
    <div class="nb-auth nb-auth-simple nb8-auth">
      <!-- phase8 2026-11-07: brand side panel (desktop only, hidden under 860px) -->
      <aside class="nb-auth-side nb8-auth-side" aria-hidden="true">
        <div class="nb8-side-brand">
          <div class="nb-logo"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div>
          <div><div class="nb-display">نَبْض الأردن</div><div class="nb8-side-en">Jordan Clinical Simulation Academy</div></div>
        </div>
        <div class="nb8-side-copy">
          <h3>تدرّب اليوم… لتُنقذ غداً</h3>
          <p>محاكاة سريرية آمنة باللغة العربية لطلبة التمريض والطب، تتدرّب فيها على القرار قبل أن تقف أمام مريض حقيقي.</p>
          <ul>
            <li><b>١</b><span>مقابلة المريض وقراءة العلامات الحيوية</span></li>
            <li><b>٢</b><span>طلب الفحوصات والعلاج مع تبرير سريري</span></li>
            <li><b>٣</b><span>تسليم الحالة بصيغة SBAR ثم تقرير بأدائك</span></li>
          </ul>
        </div>
        <svg class="nb8-side-ecg" viewBox="0 0 300 40" width="100%" height="40" fill="none" stroke="currentColor" stroke-width="2"><path d="M0 20h70l12-16 14 32 12-16h40l10-12 12 24 10-12h120"/></svg>
      </aside>
      <div class="nb-auth-main">
        <div class="nb-auth-brand">
          <div class="nb-logo" aria-hidden="true"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div>
          <span class="nb-display">نَبْض الأردن</span>
          <button id="close-auth-modal-btn" class="nb-auth-close focus-ring" type="button" aria-label="إغلاق">✕</button>
        </div>

        <h2 id="auth-modal-title" class="nb-auth-title" tabindex="-1">تسجيل الدخول</h2>

        <!-- Login Pane -->
        <form id="auth-pane-login" class="nb-auth-form" style="margin-top:1.1rem">
          <label class="nb-field"><span>البريد الإلكتروني</span>
            <input id="login-email" type="email" placeholder="name@university.edu.jo" autocomplete="username" required />
          </label>
          <label class="nb-field"><span>كلمة المرور</span>
            <input id="login-pass" type="password" placeholder="أدخل كلمة المرور" autocomplete="current-password" required />
          </label>
          <div id="login-error-msg" role="alert" class="hidden p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs leading-relaxed" style="margin-bottom:.8rem"></div>
          <button id="submit-login-btn" type="submit" class="nb-btn focus-ring">تسجيل الدخول</button>
          <div class="nb-auth-alt">ليس لديك حساب؟ <button id="auth-tab-register" type="button" class="nb-auth-link">إنشاء حساب</button></div>

          <!-- Demo entry: ready accounts for the jury, no registration -->
          <div class="nb-demo-login" role="group" aria-labelledby="nb-demo-title">
            <div class="nb-demo-head">
              <span id="nb-demo-title">دخول تجريبي</span>
              <small>حسابات جاهزة للعرض، بدون تسجيل</small>
            </div>
            <div class="nb-demo-opts">
              <button type="button" class="focus-ring" data-demo-login="rana"><b>طالبة تمريض</b><span>رنا المحاسنة · السنة الرابعة</span></button>
              <button type="button" class="focus-ring" data-demo-login="med_student"><b>طالب طب</b><span>زيد العبداللات · السنة الرابعة</span></button>
              <button type="button" class="focus-ring" data-demo-login="doctor"><b>مشرف / أستاذ</b><span>د. عبدالرحمن المجالي · البوابة الأكاديمية</span></button>
            </div>
          </div>
        </form>

        <!-- Registration Pane (2 steps) -->
        <div id="auth-pane-register" class="hidden" style="margin-top:1.1rem">
          <div class="nb-steps" aria-hidden="true">
            <span class="dot on" id="reg-dot-1">1</span><span style="">بياناتك</span>
            <span class="bar" id="reg-bar"></span>
            <span class="dot" id="reg-dot-2">2</span><span>دراستك أو عملك</span>
          </div>

          <div class="nb-step is-on" id="reg-step-1">
            <label class="nb-field"><span>الاسم الكامل</span>
              <input id="reg-name" type="text" placeholder="مثال: أحمد الزعبي" autocomplete="name" />
            </label>
            <label class="nb-field"><span>البريد الإلكتروني</span>
              <input id="reg-email" type="email" placeholder="name@university.edu.jo" autocomplete="email" />
            </label>
            <label class="nb-field"><span>كلمة المرور</span>
              <input id="reg-pass" type="password" placeholder="٨ أحرف على الأقل" autocomplete="new-password" minlength="8" />
            </label>
            <!-- phase8 2026-11-07: role question and card subtitles from the reference build -->
            <div class="nb-field nb8-rolehead" style="margin-bottom:.4rem"><span id="nb8-rolehead">من أنت؟</span></div>
            <div class="nb-rolecards" id="reg-rolecards" role="group" aria-labelledby="nb8-rolehead">
              <button type="button" data-rc="nursing" class="is-on"><strong>طالب تمريض</strong><span>تقييم المريض والعناية السريرية</span></button>
              <button type="button" data-rc="medicine"><strong>طالب طب</strong><span>التشخيص التفريقي واتخاذ القرار</span></button>
              <button type="button" data-rc="supervisor"><strong>مشرف / أستاذ</strong><span>إسناد الحالات ومتابعة الطلبة</span></button>
            </div>
            <select id="reg-role" class="hidden" aria-hidden="true">
              <option value="student" selected>طالب جامعي</option>
              <option value="practitioner">ممارس صحي</option>
              <option value="professor">أستاذ جامعي</option>
            </select>
            <div id="reg-error-msg" role="alert" class="hidden p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs" style="margin-bottom:.8rem"></div>
            <button id="reg-next-btn" type="button" class="nb-btn focus-ring">التالي ←</button>
          </div>

          <div class="nb-step" id="reg-step-2">
            <div class="nb-trackchip" id="reg-track-chip"><b>مسار التمريض</b></div>
            <label class="nb-field hidden"><span>التخصص (Specialty)</span>
              <select id="reg-specialty">
                <option value="التمريض">التمريض (Nursing)</option>
                <option value="الطب">الطب البشري (Medicine)</option>
              </select>
            </label>
            <label class="nb-field" id="reg-year-wrap"><span>السنة الدراسية</span>
              <select id="reg-year">
                <option value="1">السنة الأولى (مبتدئ)</option>
                <option value="2">السنة الثانية (مبتدئ)</option>
                <option value="3">السنة الثالثة (متقدم)</option>
                <option value="4" selected>السنة الرابعة (متقدم)</option>
                <option value="5">السنة الخامسة / السادسة (طب سريري)</option>
              </select>
            </label>
            <label class="nb-field" id="reg-code-wrap"><span>رمز الشعبة (اختياري)</span><input id="reg-code" type="text" placeholder="مثال: NUR-JU-2026" style="direction:ltr;text-align:right" /><small class="nb8-field-hint">يعطيك المشرف هذا الرمز لتظهر لك واجبات شعبتك. يمكنك إضافته لاحقاً من بوابة المساقات.</small></label>
            <label class="nb-field"><span>الجامعة / الجهة</span>
              <input id="reg-uni" type="text" placeholder="الجامعة الأردنية، العلوم والتكنولوجيا…" />
            </label>
            <div id="reg-submit-error" role="alert" class="hidden p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs" style="margin-bottom:.8rem"></div>
            <div style="display:flex;gap:.6rem">
              <button id="reg-back-btn" type="button" class="nb-btn-ghost focus-ring">→ رجوع</button>
              <button id="submit-register-btn" type="button" class="nb-btn focus-ring" style="flex:1">إنشاء الحساب وبدء التدريب</button>
            </div>
          </div>
          <div class="nb-auth-alt"><span>لديك حساب؟</span> <button id="auth-tab-login" type="button" class="nb-auth-link">تسجيل الدخول</button></div>
        </div>

        <p class="nb-auth-about">محاكاة سريرية بالعربية. يُحفظ الحساب والتقدّم على هذا الجهاز، أما كلامك في الغرفة فيُرسل إلى خدمة ذكاء اصطناعي لفهمه.</p>
      </div>
    </div>
  </div>

