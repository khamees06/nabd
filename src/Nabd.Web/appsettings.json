{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UnderstandingServices": {
    "ErRoom": {
      "Enabled": true,
      "Endpoint": "https://nabd-smoky-one.vercel.app/api/er-chat",
      "TimeoutSeconds": 20
    },
    "RespiratoryRoom": {
      "Enabled": true,
      "Endpoint": "https://nabd-smoky-one.vercel.app/api/resp-chat",
      "TimeoutSeconds": 20
    }
  },
  "RateLimits": {
    "UnderstandingPerMinute": 40,
    "SimulationPerMinute": 240
  },
  "Simulation": {
    "Sessions": {
      "MaximumSessions": 500,
      "IdleMinutes": 120
    },
    "ServerSessionsApi": {
      "Enabled": false
    }
  }
}
